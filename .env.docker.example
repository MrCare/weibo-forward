# docker compose 环境变量示例
# cp .env.docker.example .env 后 docker compose up -d

PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请修改为强密码
ALLOW_REGISTER=true
HEADLESS=true
SKIP_WEIBO_HOME_VERIFY=1

# Docker 内使用 Qwen 云端 API（必填，勿提交真实 key）
COMMENT_GENERATOR=api
QWEN_API_KEY=sk-你的DashScope密钥
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 定时转发（cron 五段式，时区 Asia/Shanghai）
CRON_ENABLED=true
CRON_TZ=Asia/Shanghai

# 扫码登录页对外 URL（部署到域名时改为 https://你的域名）
PUBLIC_BASE_URL=http://localhost:3000

# 扫码登录浏览器（Docker 建议 true；本机调试可 false 看窗口）
LOGIN_HEADLESS=true
