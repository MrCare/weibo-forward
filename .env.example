# 要转发的源账号 UID（也可用 CLI --uid 指定）
SOURCE_UID=1234567890

# 单次最多处理条数
FORWARD_LIMIT=1

# 浏览器无头模式：false 更利于过风控，true 适合服务器
HEADLESS=false

# 仅生成文案，不点击转发、不写记录（也可用 CLI --dry-run）
DRY_RUN=false

# 转发评语由本机 qwen 命令行生成，无需 API 密钥
# 需先安装 qwen CLI：https://github.com/QwenLM/qwen-code

# 跳过 forward 启动时的微博首页登录校验（网络慢时可设为 1）
# SKIP_WEIBO_HOME_VERIFY=1

# --- 评语生成（本地 CLI 默认；有 API Key 时自动切 api）---
# COMMENT_GENERATOR=cli
# QWEN_API_KEY=sk-xxx
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# --- 本地 API 多用户模式 ---
# DATABASE_PATH=data/app.db
# npm run start:api
