# 内容清理规则：按时间范围扫描本人时间线，命中 tag 即删除
cleanupRules:
  - id: video-dreame-yuhao
    accountId: my-main
    enabled: true
    since: "2025-05-01"   # 默认当年 5 月 1 日，不写则自动使用
    until: "2025-06-15"   # 默认今天，不写则自动使用
    # postTypes: [video]  # 可选，留空或不写表示不限媒体类型
    requiredTags: ["追觅", "俞浩"]  # 命中任一 tag 即删除
    # schedule: "0 10 * * *"     # 预留 cron
