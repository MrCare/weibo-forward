# 复制为 rules.yaml 后按需修改
# cp rules.yaml.example rules.yaml

accounts:
  # 你的转发微博号（用于登录、发转发）
  - id: my-main
    # 可选：自定义登录态路径，默认 data/accounts/my-main/storageState.json
    # storageState: data/accounts/my-main/storageState.json

rules:
  # 从源账号抓博并用自己的号转发
  - id: rule-brand
    forwardAccountId: my-main
    sourceUid: "1234567890"   # 源账号 UID（请改为实际值）
    limit: 1
    enabled: true
    # promptProfile: default  # 预留，当前均使用默认 qwen 提示词
    # schedule: "0 9 * * *"   # 预留，可用系统 cron 调用 forward --rule

  - id: rule-another
    forwardAccountId: my-main
    sourceUid: "1234567890"
    limit: 3
    enabled: false
